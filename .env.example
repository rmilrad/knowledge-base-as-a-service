# Database
DATABASE_URL=postgresql+asyncpg://kbaas:kbaas@localhost:5432/kbaas

# S3 — leave S3_ENDPOINT_URL empty for real AWS S3 (uses IAM role)
# Set it for local dev with MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=kbaas-docs
S3_REGION=us-east-1

# Anthropic (LLM for chat — embeddings are local via fastembed)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# JWT — REQUIRED: generate with `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Frontend (set in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
